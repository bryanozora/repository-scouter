GITHUB_TOKEN=your-github-token-here
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434/v1

# Agent limits (M1)
MAX_STEPS=15
MAX_FILE_BYTES=100000
MAX_TOOL_RESULT_CHARS=2500
TOOL_TIMEOUT_SECONDS=15
# Local Ollama is slow: a full scan takes several minutes on an 8GB machine.
SCAN_TIMEOUT_SECONDS=400

# Token guardrails (M2b). MAX_PROMPT_TOKENS must stay below the model's
# effective context window: 4096 tokens with Ollama's defaults (measured,
# see docs/NOTES.md) -- a longer prompt is silently cut from the start.
MAX_PROMPT_TOKENS=3300
MAX_TOTAL_TOKENS=60000

# Corrective nudges for small-model failure modes (see backend/app/agent/loop.py).
# Set to false to measure the agent without them.
AGENT_NUDGES=true

# After the scan, one JSON-schema-constrained call asks the model to list its
# findings (qwen2.5:7b rarely calls report_finding as a tool on its own).
FORCED_REPORT=true

# Before the model's first turn, search for password/secret/token/key/SELECT/
# execute( and put the matching lines into its first message.
CANDIDATE_SEARCHES=true
